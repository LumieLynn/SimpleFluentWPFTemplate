<ui:Page x:Class="SimpleTemplate.Views.AppsPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SimpleTemplate.Views"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AppsPageView">

    <Grid>
        <ui:ItemsRepeaterScrollHost>
            <ui:ScrollViewerEx VerticalScrollBarVisibility="Auto">
                <ui:ItemsRepeater ItemsSource="{Binding ButtonSource}">
                    <ui:ItemsRepeater.Layout>
                        <ui:UniformGridLayout
                            MinItemWidth="84"
                            MinItemHeight="84"
                            MinRowSpacing="4"
                            MinColumnSpacing="4"/>
                    </ui:ItemsRepeater.Layout>
                    <ui:ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Background="{Binding}"
                                Width="80"
                                Height="80"
                                Margin="2"/>
                        </DataTemplate>
                    </ui:ItemsRepeater.ItemTemplate>
                </ui:ItemsRepeater>
            </ui:ScrollViewerEx>
        </ui:ItemsRepeaterScrollHost>
    </Grid>
</ui:Page>
